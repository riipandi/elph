{
  "id": "elph",
  "name": "Elph",
  "version": "0.0.1",
  "description": "Minimalist AI coding agent. ACP v1 over stdio; sign in with `elph acp --setup`.",
  "repository": "https://github.com/riipandi/elph",
  "website": "https://elph.space",
  "authors": ["Aris Ripandi"],
  "license": "Apache-2.0",
  "distribution": {
    "binary": {
      "darwin-aarch64": {
        "archive": "https://github.com/riipandi/elph/releases/download/v0.0.1/elph-aarch64-apple-darwin.tar.gz",
        "cmd": "./elph",
        "args": ["acp", "--stdio"]
      },
      "darwin-x86_64": {
        "archive": "https://github.com/riipandi/elph/releases/download/v0.0.1/elph-x86_64-apple-darwin.tar.gz",
        "cmd": "./elph",
        "args": ["acp", "--stdio"]
      },
      "linux-aarch64": {
        "archive": "https://github.com/riipandi/elph/releases/download/v0.0.1/elph-aarch64-unknown-linux-gnu.tar.gz",
        "cmd": "./elph",
        "args": ["acp", "--stdio"]
      },
      "linux-x86_64": {
        "archive": "https://github.com/riipandi/elph/releases/download/v0.0.1/elph-x86_64-unknown-linux-gnu.tar.gz",
        "cmd": "./elph",
        "args": ["acp", "--stdio"]
      },
      "windows-x86_64": {
        "archive": "https://github.com/riipandi/elph/releases/download/v0.0.1/elph-x86_64-pc-windows-msvc.zip",
        "cmd": "elph.exe",
        "args": ["acp", "--stdio"]
      }
    }
  }
}
