<header class="site-nav sticky top-0 z-50 backdrop-blur-xl">
  <nav class="max-w-7xl w-full mx-auto px-5 sm:px-8">
    <div class="flex justify-between items-center h-14">
      <a href="/" class="flex items-center gap-2.5">
        <img src="/favicon.svg" width="28" height="28" alt="" class="w-7 h-7" />
        <span class="text-[15px] font-semibold" style="color: var(--chrome-fg)">Elph</span>
      </a>

      <div class="hidden md:flex items-center gap-6">
        <a href="/docs" class="nav-link {{currentPath?.startsWith('/docs') ? 'is-active' : ''}}">Docs</a>
        <a href="/news" class="nav-link {{currentPath?.startsWith('/news') ? 'is-active' : ''}}">News</a>
        <a href="/faqs" class="nav-link {{currentPath?.startsWith('/faqs') ? 'is-active' : ''}}">FAQs</a>
        <div class="w-px h-4" style="background: var(--chrome-line)"></div>
        <button type="button" onclick="toggleDarkMode()" aria-label="Toggle color theme"
          class="p-1.5 transition-colors" style="color: var(--chrome-muted)">
          <svg class="theme-icon-moon w-[16px] h-[16px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          <svg class="theme-icon-sun w-[16px] h-[16px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        </button>
        <pagefind-modal-trigger compact hide-shortcut class="search-trigger" aria-label="Search"></pagefind-modal-trigger>
        <a href="https://github.com/riipandi/elph" target="_blank" rel="noopener noreferrer"
          class="p-1.5 transition-colors" style="color: var(--chrome-fg)" aria-label="Elph on GitHub">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"/>
          </svg>
        </a>
      </div>

      <div class="flex items-center gap-1 md:hidden">
        <button type="button" onclick="toggleDarkMode()" aria-label="Toggle color theme"
          class="p-2" style="color: var(--chrome-muted)">
          <svg class="theme-icon-moon w-[16px] h-[16px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          <svg class="theme-icon-sun w-[16px] h-[16px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        </button>
        <button id="mobile-menu-button" type="button"
          class="p-2 focus-visible:outline-2 focus-visible:outline-offset-2"
          style="color: var(--chrome-muted); outline-color: var(--chrome-accent)"
          aria-label="Toggle menu" aria-expanded="false">
          <svg id="menu-icon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<div id="mobile-menu-overlay" class="hidden fixed inset-0 z-40 md:hidden bg-black/40 backdrop-blur-sm"></div>

<div id="mobile-menu" class="hidden fixed top-14 left-0 right-0 bottom-0 z-50 md:hidden">
  <div class="flex flex-col h-full w-full max-w-sm ml-auto border-l" style="background: var(--chrome-bg); border-color: var(--chrome-line)">
    <nav class="flex-1 overflow-y-auto px-5 py-6 space-y-1">
      <a href="/" class="nav-link block py-3 {{currentPath === '/' ? 'is-active' : ''}}">Home</a>
      <a href="/docs" class="nav-link block py-3 {{currentPath?.startsWith('/docs') ? 'is-active' : ''}}">Docs</a>
      <a href="/news" class="nav-link block py-3 {{currentPath?.startsWith('/news') ? 'is-active' : ''}}">News</a>
      <a href="/faqs" class="nav-link block py-3 {{currentPath?.startsWith('/faqs') ? 'is-active' : ''}}">FAQs</a>
    </nav>
    <div class="px-5 py-4">
      <div class="mobile-search-wrap overflow-hidden flex items-center" style="border-top: 1px solid var(--chrome-line)">
        <pagefind-modal-trigger hide-shortcut aria-label="Search"></pagefind-modal-trigger>
      </div>
    </div>
    <div class="px-5 py-4" style="border-top: 1px solid var(--chrome-line)">
      <a href="https://github.com/riipandi/elph" target="_blank" rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 py-3 text-sm" style="color: var(--chrome-fg)">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"/>
        </svg>
        GitHub
      </a>
    </div>
  </div>
</div>
