{{ layout "layouts/site.vto" }}

{{ setMetadata('title', post ? post.title : 'Post Not Found') }}

<div class="page-shell">
  {{ if post }}
    <header class="page-head">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 pt-12 pb-8 md:pt-16 md:pb-10">
        <p class="page-kicker mb-4">
          <a href="/news" class="hover:opacity-70">News</a>
          <span class="mx-2 opacity-40">/</span>
          <span>{{ post.dateDisplay }}</span>
        </p>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-end">
          <h1 class="lg:col-span-7 text-3xl md:text-4xl font-semibold">{{ post.title }}</h1>
          <div class="lg:col-span-5 text-sm leading-relaxed">
            {{ if post.description }}
              <p>{{ post.description }}</p>
            {{ /if }}
            <p class="mt-3" style="color: var(--chrome-muted)">
              {{ if post.author }}{{ post.author }}{{ /if }}
              {{ if post.tags && post.tags.length > 0 }}
                <span class="opacity-40 mx-2">·</span>
                {{ for tag of post.tags }}{{ tag }} {{ /for }}
              {{ /if }}
            </p>
          </div>
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto px-5 sm:px-8 py-10 md:py-14">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 min-w-0">
        <details class="lg:hidden group lg:col-span-12">
          <summary class="page-kicker cursor-pointer">On this page</summary>
          <ul class="space-y-1.5 mt-3 text-sm pl-0" id="toc-list-mobile"></ul>
        </details>

        <article class="lg:col-span-8 overflow-x-hidden min-w-0">
          <div class="prose md:prose-lg max-w-none min-w-0" id="post-content">
            {{ post.content |> safe }}
          </div>
        </article>

        <aside class="hidden lg:block lg:col-span-4">
          <nav id="post-toc" class="sticky top-20 pl-6" style="border-left: 1px solid var(--chrome-line)">
            <p class="page-kicker mb-3">On this page</p>
            <ul class="space-y-1.5 text-sm" id="toc-list"></ul>
          </nav>
        </aside>
      </div>

      <nav class="mt-16 pt-8 grid grid-cols-1 sm:grid-cols-2 gap-6" style="border-top: 1px solid var(--chrome-line)">
        <div>
          {{ if post.next }}
            <a href="/news/{{ post.next.slug }}" class="block hover:opacity-80">
              <p class="page-kicker mb-1">Next</p>
              <p class="text-sm font-semibold" style="color: var(--chrome-fg)">{{ post.next.title }}</p>
            </a>
          {{ /if }}
        </div>
        <div class="sm:text-right">
          {{ if post.prev }}
            <a href="/news/{{ post.prev.slug }}" class="block hover:opacity-80">
              <p class="page-kicker mb-1">Previous</p>
              <p class="text-sm font-semibold" style="color: var(--chrome-fg)">{{ post.prev.title }}</p>
            </a>
          {{ /if }}
        </div>
      </nav>
    </div>
  {{ else }}
    <div class="max-w-7xl mx-auto px-5 sm:px-8 py-24">
      <p class="page-kicker mb-3">News</p>
      <h1 class="text-3xl font-semibold mb-4">Article not found</h1>
      <a href="/news" class="text-sm" style="color: var(--chrome-fg)">Back to news</a>
    </div>
  {{ /if }}
</div>

<script>
(function() {
  const content = document.getElementById('post-content');
  if (!content) return;

  const tocData = [];
  const headings = content.querySelectorAll('h2, h3');
  headings.forEach((h) => {
    const id = h.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    h.id = id;
    tocData.push({ id, text: h.textContent, level: h.tagName.toLowerCase() });
  });

  if (!tocData.length) return;

  function renderToc(listId) {
    const list = document.getElementById(listId);
    if (!list) return;
    list.innerHTML = tocData.map((item) => {
      const indent = item.level === 'h3' ? 'ml-3' : '';
      return '<li class="' + indent + '">' +
        '<a href="#' + item.id + '" class="toc-link">' +
        item.text + '</a></li>';
    }).join('');
  }
  renderToc('toc-list');
  renderToc('toc-list-mobile');

  const links = document.querySelectorAll('.toc-link');
  if (!links.length) return;

  const observer = new IntersectionObserver(
    (entries) => {
      let activeId = '';
      entries.forEach((entry) => {
        if (entry.isIntersecting) activeId = entry.target.id;
      });
      if (!activeId) return;
      links.forEach((link) => {
        link.classList.toggle('active', link.getAttribute('href') === '#' + activeId);
      });
    },
    { rootMargin: '-80px 0px -70% 0px' }
  );

  headings.forEach((h) => observer.observe(h));
})();
</script>
