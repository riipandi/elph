{{ layout "layouts/site.vto" }}

{{ setMetadata('title', 'Page not found') }}

<div class="page-shell">
  <section>
    <div class="max-w-7xl mx-auto px-5 sm:px-8 pt-24 pb-28 md:pt-32 md:pb-36">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] mb-3" style="color: var(--chrome-muted)">404</p>
      <h1 class="text-3xl md:text-4xl font-semibold">This path is empty.</h1>
      <p class="mt-4 text-base leading-relaxed max-w-md">
        The page does not exist, or it moved. Try home, docs, or news.
      </p>
      <div class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href="/" style="color: var(--chrome-fg)">Home</a>
        <a href="/docs" style="color: var(--chrome-fg)">Docs</a>
        <a href="/news" style="color: var(--chrome-fg)">News</a>
        <a href="/faqs" style="color: var(--chrome-fg)">FAQs</a>
      </div>
    </div>
  </section>
</div>
