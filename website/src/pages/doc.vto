{{ layout "layouts/docs.vto" }}

{{ setMetadata('title', doc ? doc.title : 'Doc Not Found') }}
{{ setMetadata('description', doc ? doc.description : '') }}

<div class="page-shell">
<div class="w-full max-w-7xl mx-auto px-5 sm:px-8 grid grid-cols-1 lg:grid-cols-[16rem_minmax(0,1fr)] grow">
  {{ include "partials/docs-sidebar.vto" }}

  <div class="min-w-0 py-10 md:py-8 xl:px-8">
    {{ if doc }}
      <nav class="flex items-center gap-2 text-sm text-sand-400 dark:text-sand-500 mb-8">
        <a href="/docs" class="hover:text-sand-600 dark:hover:text-sand-300 transition-colors">Docs</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="m9 18 6-6-6-6"/></svg>
        <span class="text-sand-600 dark:text-sand-300 capitalize">{{ doc.sectionLabel }}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="m9 18 6-6-6-6"/></svg>
        <span class="text-sand-600 dark:text-sand-300">{{ doc.title }}</span>
      </nav>

      <article class="prose prose-lg max-w-none">
        {{ doc.content |> safe }}
      </article>

      <!-- Doc navigation: prev / next -->
      <nav class="mt-16 pt-8" style="border-top: 1px solid var(--chrome-line)">
        <div class="flex items-center justify-between gap-4">
          {{ if doc.prev }}
            <a href="/docs/{{ doc.prev.slug }}"
              class="group flex flex-col items-start gap-0.5 min-w-0 flex-1">
              <span class="text-xs font-medium tracking-wider" style="color: var(--chrome-muted)">Previous page</span>
              <span class="text-sm font-semibold truncate max-w-full transition-colors group-hover:opacity-70" style="color: var(--chrome-fg)">
                {{ doc.prev.title }}
              </span>
            </a>
          {{ else }}
            <div></div>
          {{ /if }}

          {{ if doc.next }}
            <a href="/docs/{{ doc.next.slug }}"
              class="group flex flex-col items-end gap-0.5 min-w-0 flex-1 text-right">
              <span class="text-xs font-medium tracking-wider" style="color: var(--chrome-muted)">Next page</span>
              <span class="text-sm font-semibold truncate max-w-full transition-colors group-hover:opacity-70" style="color: var(--chrome-fg)">
                {{ doc.next.title }}
              </span>
            </a>
          {{ else }}
            <div></div>
          {{ /if }}
        </div>
      </nav>

    {{ else }}
      <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
        <div class="w-16 h-16 rounded-2xl bg-sand-100 dark:bg-sand-800 flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-sand-400 dark:text-sand-500"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
        </div>
        <h1 class="text-3xl font-bold text-sand-900 dark:text-white mb-3">Doc not found</h1>
        <p class="text-sand-500 dark:text-sand-400 mb-8 max-w-md">
          The documentation page you're looking for doesn't exist or has been moved.
        </p>
        <a href="/docs"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-sand-900 dark:bg-white text-white dark:text-sand-900 font-medium text-sm hover:bg-sand-800 dark:hover:bg-sand-100 transition-colors">
          Browse all docs
        </a>
      </div>
    {{ /if }}
</div>
</div>
