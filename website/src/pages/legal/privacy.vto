{{ layout "layouts/site.vto" }}

{{ setMetadata('title', 'Privacy Policy') }}
{{ setMetadata('description', 'How elph.space handles visitor data.') }}

<div class="page-shell">
  <header class="page-head">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 pt-14 pb-10 md:pt-20 md:pb-12">
      <p class="page-kicker mb-4">Legal</p>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-end">
        <h1 class="lg:col-span-7 text-3xl md:text-4xl font-semibold">Privacy</h1>
        <p class="lg:col-span-5 text-base leading-relaxed">
          elph.space is a static site. It does not run an account system or its own analytics.
        </p>
      </div>
    </div>
  </header>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-5 sm:px-8">
      <div class="prose max-w-none">
      <h2>What we collect</h2>
      <p>
        This website does not collect personal information in application code. It does not set first-party analytics cookies.
        The hosting platform (Cloudflare) may log standard request metadata to operate the CDN.
      </p>
      <h2>External links</h2>
      <p>
        Links go to GitHub, X, and other third parties. Their policies apply when you leave this site.
      </p>
      <h2>The Elph binary</h2>
      <p>
        The local agent is separate from this website. Sessions, memory, and the code index stay on your machine under
        <code>.elph/</code> and your Elph home directory unless you configure otherwise.
      </p>
      <h2>Contact</h2>
      <p>
        Questions:
        <a href="https://github.com/riipandi/elph/issues">github.com/riipandi/elph/issues</a>.
      </p>
      </div>
    </div>
  </section>
</div>
