{{ layout "layouts/site.vto" }}

{{ setMetadata('title', 'Changelog') }}
{{ setMetadata('description', 'Elph is pre-alpha. Track releases on GitHub.') }}

<div class="page-shell">
  <header class="page-head">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 pt-14 pb-10 md:pt-20 md:pb-12">
      <p class="page-kicker mb-4">Changelog</p>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-end">
        <h1 class="lg:col-span-7 text-3xl md:text-4xl font-semibold">What shipped</h1>
        <p class="lg:col-span-5 text-base leading-relaxed">
          Elph is pre-alpha. Breaking changes land often. The canonical log is GitHub Releases.
        </p>
      </div>
    </div>
  </header>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-5 sm:px-8">
      <p class="text-sm leading-relaxed">
        This page will list site-facing notes. Until then, read
        <a href="https://github.com/riipandi/elph/releases" class="underline underline-offset-2" style="color: var(--chrome-fg)">github.com/riipandi/elph/releases</a>
        before you upgrade.
      </p>
    </div>
  </section>
</div>
