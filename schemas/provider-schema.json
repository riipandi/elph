{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://elph.space/provider-schema.json",
    "title": "Elph AI provider catalog",
    "description": "One provider per JSON file. Filename without extension is the provider id (kebab-case). Canonical shape is crates/elph-ai/models/*.json: a map of modelId → model entry, plus optional $schema. A wrapper { name, api, baseUrl, headers, auth, models } is also accepted. Runtime merges CONFIG_DIR/providers/<id>.json over the embedded catalog by model id.",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string",
            "format": "uri-reference",
            "description": "JSON Schema URL (editor autocompletion). Ignored at runtime."
        },
        "name": {
            "type": "string",
            "description": "Optional display name for the provider (wrapper form only)."
        },
        "baseUrl": {
            "type": "string",
            "description": "Default base URL stamped onto models that omit or leave baseUrl empty (wrapper form)."
        },
        "api": {
            "$ref": "#/$defs/ApiKind",
            "description": "Default wire protocol when a model omits per-model api (wrapper form)."
        },
        "headers": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "Optional static HTTP headers. Wrapper headers apply to models that omit headers."
        },
        "auth": {
            "type": "object",
            "description": "Reserved credential hints (env var names, oauth id). Not loaded by the catalog parser.",
            "additionalProperties": true
        },
        "models": {
            "type": "object",
            "description": "Wrapper-form map of modelId → model entry.",
            "additionalProperties": { "$ref": "#/$defs/ModelEntry" }
        }
    },
    "additionalProperties": { "$ref": "#/$defs/ModelEntry" },
    "$defs": {
        "ApiKind": {
            "type": "string",
            "enum": [
                "openai-completions",
                "openai-responses",
                "openai-codex-responses",
                "azure-openai-responses",
                "anthropic-messages",
                "google-generative-ai",
                "google-vertex",
                "bedrock-converse-stream",
                "mistral-conversations",
                "openrouter-images"
            ]
        },
        "InputModality": {
            "type": "string",
            "enum": ["text", "image", "pdf", "video", "audio"]
        },
        "OutputModality": {
            "type": "string",
            "enum": ["text", "image"]
        },
        "ThinkingLevelMap": {
            "type": "object",
            "description": "Wire mapping for reasoning effort. All seven keys are always present; null = unsupported.",
            "additionalProperties": false,
            "required": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
            "properties": {
                "off": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
                "minimal": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
                "low": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
                "medium": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
                "high": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
                "xhigh": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
                "max": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
            }
        },
        "ModelCost": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "output", "cacheRead", "cacheWrite"],
            "properties": {
                "input": { "type": "number" },
                "output": { "type": "number" },
                "cacheRead": { "type": "number" },
                "cacheWrite": { "type": "number" },
                "tiers": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "inputTokensAbove",
                            "input",
                            "output",
                            "cacheRead",
                            "cacheWrite"
                        ],
                        "properties": {
                            "inputTokensAbove": { "type": "integer", "minimum": 0 },
                            "input": { "type": "number" },
                            "output": { "type": "number" },
                            "cacheRead": { "type": "number" },
                            "cacheWrite": { "type": "number" }
                        }
                    }
                }
            }
        },
        "CompatFlags": {
            "type": "object",
            "description": "Provider-specific compatibility flags. Known keys are documented; extra keys are allowed.",
            "additionalProperties": true,
            "properties": {
                "supportsDeveloperRole": { "type": "boolean" },
                "supportsStore": { "type": "boolean" },
                "supportsReasoningEffort": { "type": "boolean" },
                "supportsUsageInStreaming": { "type": "boolean" },
                "supportsStrictMode": { "type": "boolean" },
                "supportsOpenAIGrammarTools": { "type": "boolean" },
                "supportsLongCacheRetention": { "type": "boolean" },
                "supportsToolSearch": { "type": "boolean" },
                "supportsEagerToolInputStreaming": { "type": "boolean" },
                "supportsCacheControlOnTools": { "type": "boolean" },
                "supportsTemperature": { "type": "boolean" },
                "supportsStrictTools": { "type": "boolean" },
                "supportsToolReferences": { "type": "boolean" },
                "supportsFinishReason": { "type": "boolean" },
                "supportsThinkingTokenBudget": { "type": "boolean" },
                "supportsExplicitPromptCacheMode": { "type": "boolean" },
                "forceAdaptiveThinking": { "type": "boolean" },
                "allowEmptySignature": { "type": "boolean" },
                "requiresToolResultName": { "type": "boolean" },
                "requiresAssistantAfterToolResult": { "type": "boolean" },
                "requiresThinkingAsText": { "type": "boolean" },
                "requiresReasoningContentOnAssistantMessages": { "type": "boolean" },
                "sendSessionAffinityHeaders": { "type": "boolean" },
                "sendSessionIdHeader": { "type": "boolean" },
                "zaiToolStream": { "type": "boolean" },
                "maxTokensField": { "type": "string" },
                "thinkingFormat": { "type": "string" },
                "cacheControlFormat": { "type": "string" },
                "deferredToolsMode": { "type": "string" },
                "sessionAffinityFormat": {
                    "type": "string",
                    "enum": ["openai", "openai-no-session", "openai-nosession", "openrouter"]
                },
                "samplingParams": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "ModelEntry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "api", "provider", "baseUrl", "input", "cost"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "api": { "$ref": "#/$defs/ApiKind" },
                "provider": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Must match the provider file id (kebab-case)."
                },
                "baseUrl": { "type": "string" },
                "reasoning": { "type": "boolean" },
                "thinkingLevelMap": { "$ref": "#/$defs/ThinkingLevelMap" },
                "input": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/InputModality" },
                    "minItems": 1
                },
                "output": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/OutputModality" }
                },
                "contextWindow": { "type": "integer", "minimum": 0 },
                "maxTokens": { "type": "integer", "minimum": 0 },
                "cost": { "$ref": "#/$defs/ModelCost" },
                "description": { "type": "string" },
                "knowledgeCutoff": { "type": "string" },
                "releaseDate": { "type": "string" },
                "compat": { "$ref": "#/$defs/CompatFlags" },
                "headers": {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                }
            }
        }
    }
}
